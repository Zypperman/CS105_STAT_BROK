   "source": [
    "<span style=\"color:LightSkyBlue\">\n",
    "\n",
    "For certain features, please note that shifts have been applied to them as we acknowledge that there may be some interactions between chemicals in the atmosphere that may be delayed, thus we have assessed what the best shifts should be by measuring their MSE relative to the differences in our `Temp` variable (which has been recorded as `Temp_diff`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 854,
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def best_shift(feature,data):\n",
    "    from sklearn.metrics import mean_squared_error\n",
    "    from sklearn.preprocessing import StandardScaler\n",
    "    \n",
    "    # Define the range of shift values to test\n",
    "    shift_range = range(-12, 13)  # Example: test shifts from -12 to +12 months\n",
    "    best_shift = None\n",
    "    min_mse = float('inf')\n",
    "\n",
    "    # Iterate over the shift range\n",
    "    for shift in shift_range:\n",
    "        # Apply the shift to Temp_diff\n",
    "        new_feature = feature.replace('-','_') if '-' in feature else feature\n",
    "        data[new_feature+'_MA'] = data[feature].rolling(window=12).mean()\n",
    "        data[new_feature+'_diff'] = data[feature] - data[new_feature+'_MA']\n",
    "        data[new_feature+'_diff_shifted'] = data[new_feature+'_diff'].shift(shift)\n",
    "        data[new_feature+'_diff_st'] = StandardScaler().fit_transform(data[[new_feature+'_diff_shifted']])\n",
    "        #data[\"Temp_MA\"] = data[\"Temp\"].rolling(window=12).mean()\n",
    "        #data[\"Temp_diff\"] = data[\"Temp\"] - data[\"Temp_MA\"]\n",
    "        #data[\"Temp_diff_st\"] = StandardScaler().fit_transform(data[[\"Temp_diff\"]])\n",
    "        data[\"Temp_st\"] = StandardScaler().fit_transform(data[[\"Temp\"]])\n",
    "        mse_arr = data.copy()\n",
    "        mse_arr = mse_arr.dropna()\n",
    "        # Calculate MSE between Temp_diff_st_z and Temp_diff_st\n",
    "        #mse = mean_squared_error(mse_arr['Temp_diff_st'], mse_arr[new_feature+'_diff_st'])\n",
    "        mse = mean_squared_error(mse_arr['Temp_st'], mse_arr[new_feature+'_diff_st'])\n",
    "        \n",
    "        # Update the best shift if the current MSE is smaller\n",
    "        if mse < min_mse:\n",
    "            min_mse = mse\n",
    "            best_shift = shift\n",
    "\n",
    "    print(f\"Best shift: {best_shift}, Minimum MSE: {min_mse}\")\n",
    "    data.loc[:, ~data.columns.duplicated()]\n",
    "    #return best_shift"
   ]
