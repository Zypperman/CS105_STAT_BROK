  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Gaps in the graph of year against month indicate missing aerosol values. It can be observed that since the aerosol levels for adjacent months of all the missing values are usually the same, we can impute the samples with missing data following the assumption that if the samples from adjacent months have the same aerosol value, the sample itself will also have the same aerosol value. (ie  Aerosol = 'M' for samples (1,1997) and (3,1997), hence we impute (2,1997) to also have Aerosol = 'M' where applicable)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### The Fix:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 794,
   "metadata": {},
   "outputs": [],
   "source": [
    "# get rows with missing Aerosol values\n",
    "Aerosol_missing_values = dataset_fixed_months[dataset_fixed_months['Aerosols'].isna()]\n",
    "\n",
    "analysed_rows = ['Year','Month','Aerosols']\n",
    "\n",
    "\n",
    "for current_index,row in Aerosol_missing_values.iterrows():\n",
    "    #get previous index's year and month\n",
    "    prior_index = current_index - 1\n",
    "    prev_A_level = dataset_fixed_months.loc[prior_index, 'Aerosols']\n",
    "    \n",
    "    next_index = current_index + 1\n",
    "    next_A_level = dataset_fixed_months.loc[next_index, 'Aerosols']\n",
    "    \n",
    "    #fill rows with the same adjacent Aerosol values\n",
    "    if prev_A_level == next_A_level:\n",
    "        dataset_fixed_months.loc[current_index,'Aerosols'] = prev_A_level\n",
    "\n",
    "# finalize dataset by dropping unfillable Aerosol values\n",
    "dataset_full_clean = dataset_fixed_months.copy()\n"
