   "execution_count": 849,
   "metadata": {},
   "outputs": [],
   "source": [
    "data['CFC_add_lg'] = np.log(data['CFC_add'])\n",
    "numerical_features.append('CFC_add_lg')\n",
    "\n",
    "data['CFC_times_lg'] = np.log(data['CFC_times'])\n",
    "numerical_features.append('CFC_times_lg')"
   ]
